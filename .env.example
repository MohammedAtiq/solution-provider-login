# Copy to .env.local and fill in. NEXT_PUBLIC_* values are baked in at build time
# and visible in the browser bundle — rebuild after changing them.

# Product catalogue + partner_login backend, no trailing slash
# (login calls ${NEXT_PUBLIC_API_BASE_URL}/partner_login)
NEXT_PUBLIC_API_BASE_URL=
# Base URL for relative product image paths (falls back to NEXT_PUBLIC_API_BASE_URL)
NEXT_PUBLIC_IMAGE_BASE_URL=

# External VBG (Verified by GS1) application — target of the "Open VBG Application" buttons
NEXT_PUBLIC_VBG_APP_URL=

# Optional test account shown on the login page. Leave empty in production to hide the box.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# Optional server-side proxy: when set, /backend/* is forwarded here, so an HTTPS site
# can reach an HTTP backend — then set NEXT_PUBLIC_API_BASE_URL=/backend (see .env.production)
API_PROXY_TARGET=
