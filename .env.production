# Production build settings (committed, so the host needs no dashboard config).
# Local `npm run dev` ignores this file and uses .env.local instead.
# Never put passwords or tokens here — NEXT_PUBLIC_* values are public.

# The site is HTTPS but the backend is plain HTTP, which browsers block.
# So the browser calls same-origin /backend/* and the Next.js server forwards it here.
API_PROXY_TARGET=http://20.233.200.211/api
NEXT_PUBLIC_API_BASE_URL=/backend

NEXT_PUBLIC_IMAGE_BASE_URL=https://gs1.org.sa/
NEXT_PUBLIC_VBG_APP_URL=https://vbg.gs1.org.sa/vbg/login
